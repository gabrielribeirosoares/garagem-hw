rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ======================================================
    // FUNÇÃO AUXILIAR: Verifica se o usuário logado é Admin
    // ======================================================
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 1. Permite ler o contador e atualizar se estiver logado
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 2. Perfis: O próprio usuário edita o seu, OU o Admin edita qualquer um
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // 3. Coleções: O dono gerencia a sua, OU o Admin gerencia
    match /collections/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}