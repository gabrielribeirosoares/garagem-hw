rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ======================================================
    // FUNÇÃO AUXILIAR: Verifica se o usuário é Admin ou Gerente
    // ======================================================
    function hasElevatedPrivileges() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && (userData.role == 'admin' || userData.role == 'gerente');
    }

    // 1. Permite ler o contador e atualizar se estiver logado
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 2. Perfis: O dono edita o seu, OU o Admin/Gerente edita qualquer um
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || hasElevatedPrivileges());
    }
    
    // 3. Coleções: O dono gerencia a sua, OU o Admin/Gerente gerencia (para injeção e rifas)
    match /collections/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || hasElevatedPrivileges());
    }
  }
}