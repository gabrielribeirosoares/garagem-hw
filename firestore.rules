rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Perfil do usuário: cada usuário só lê/escreve seu próprio documento.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Coleção pessoal: cada usuário só lê/escreve sua própria coleção.
    match /collections/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Bloqueia explicitamente qualquer outro documento/coleção.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}