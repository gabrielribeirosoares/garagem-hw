rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasElevatedPrivileges() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null && (userDoc.data.role == 'admin' || userDoc.data.role == 'gerente');
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || hasElevatedPrivileges());
    }

    match /collections/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || hasElevatedPrivileges());
    }

    // NOVO: Regra para as configurações independentes de cada Loja
    match /lojas/{lojaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && hasElevatedPrivileges();
    }
  }
}